<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ananda_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ================= TIME SEGMENTED ================= -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/timeToggle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:background="@color/white"
            app:checkedButton="@id/btnUptoMonth">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Today"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUptoDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Upto Day"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUptoMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Upto Month"
                android:textAllCaps="false"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ================= MODE FILTER ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/growthMRB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By Growth"
                    app:chipIcon="@drawable/ic_trending_up"
                    app:chipIconVisible="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/colorPrimary"
                    app:chipBackgroundColor="@color/selector_chip_bg" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/volumeMRB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By Volume"
                    app:chipIcon="@drawable/ic_bar_chart"
                    app:chipIconVisible="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/colorPrimary"
                    app:chipBackgroundColor="@color/selector_chip_bg" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/a2bMRB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By A2B"
                    app:chipIcon="@drawable/ic_swap"
                    app:chipIconVisible="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/colorPrimary"
                    app:chipBackgroundColor="@color/selector_chip_bg" />
            </com.google.android.material.chip.ChipGroup>
        </androidx.cardview.widget.CardView>

        <!-- ================= BRANCH ================= -->
        <TextView
            android:id="@+id/branchNameTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Branch: 71M"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ================= METRIC GRID ================= -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2">

            <include layout="@layout/item_nb_metric" />
            <include layout="@layout/item_nb_metric" />
            <include layout="@layout/item_nb_metric" />
            <include layout="@layout/item_nb_metric" />
            <include layout="@layout/item_nb_metric" />
            <include layout="@layout/item_nb_metric" />

        </GridLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
